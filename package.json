{
  "name": "@xfcfam/tools",
  "version": "0.1.2",
  "description": "Validator and toolkit for the XF Architecture Model. Built as an XF artefact — validates itself.",
  "author": "XF Contributors",
  "license": "MIT",
  "homepage": "https://xfcfam.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/xfcfam/tools"
  },
  "keywords": [
    "xf",
    "cfam",
    "validator",
    "linter",
    "architecture"
  ],
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "xftools": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx main.ts validate",
    "link": "pnpm build && pnpm link --global",
    "unlink": "pnpm unlink --global",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@xfcfam/xf": "^0.2.0",
    "java-parser": "^3.0.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
